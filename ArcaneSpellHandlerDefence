	mainVortex.Speed = NumberRange.new(0.2, 0.5)
	mainVortex.SpreadAngle = Vector2.new(-5, 5)
	mainVortex.Rotation = NumberRange.new(0, 360)
	mainVortex.RotSpeed = NumberRange.new(-30, 30)
