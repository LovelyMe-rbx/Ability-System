				end)
			end
		end)
	end

	-- Expose damage feedback function for use in health changed event
	centralAttachment:SetAttribute("createDamageFeedback", true)  -- Mark for reference

	-- Comprehensive cleanup function
	local cleanupFunc = function()
		if centralAttachment and centralAttachment.Parent then
			centralAttachment:Destroy()
		end

		for _, shield in ipairs(shields) do
			if shield and shield.Parent then
