	mainVortex.Parent = centralAttach
	table.insert(effects, mainVortex)

	-- Clock-like runes
	local runeEmitter = Instance.new("ParticleEmitter")
	runeEmitter.Texture = "rbxassetid://8177248319"
	runeEmitter.Lifetime = NumberRange.new(1.2, 1.8)
	runeEmitter.Rate = 8
	runeEmitter.Speed = NumberRange.new(0.5, 1)
	runeEmitter.Rotation = NumberRange.new(0, 360)
	runeEmitter.RotSpeed = NumberRange.new(-10, 10)
	runeEmitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.5),
		NumberSequenceKeypoint.new(0.2, 1),
		NumberSequenceKeypoint.new(0.8, 1),
		NumberSequenceKeypoint.new(1, 0.5)
	})
	runeEmitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4),
		NumberSequenceKeypoint.new(0.5, 0.3),
		NumberSequenceKeypoint.new(1, 1)
	})
	runeEmitter.Color = ColorSequence.new(Color3.fromRGB(220, 180, 255))
	runeEmitter.LightEmission = 0.6
	runeEmitter.Parent = centralAttach
	table.insert(effects, runeEmitter)

	-- Outer arcane barrier
	local barrierEmitter = Instance.new("ParticleEmitter")
	barrierEmitter.Texture = "rbxassetid://244221613"
	barrierEmitter.Lifetime = NumberRange.new(1.5, 2)
	barrierEmitter.Rate = 10
	barrierEmitter.Speed = NumberRange.new(0)
	barrierEmitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 6),
		NumberSequenceKeypoint.new(0.5, 7),
		NumberSequenceKeypoint.new(1, 6)
	})
	barrierEmitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4),
		NumberSequenceKeypoint.new(0.5, 0.5),
		NumberSequenceKeypoint.new(1, 0.8)
	})
	barrierEmitter.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(160, 120, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 100, 255))
	})
	barrierEmitter.LightEmission = 0.7
	barrierEmitter.Parent = centralAttach
	table.insert(effects, barrierEmitter)

	-- Orbiting fragments
	local orbitParts = {}
	for i = 1, 5 do
		local orbitPart = Instance.new("Part")
		orbitPart.Size = Vector3.new(0.2, 0.2, 0.2)
		orbitPart.Transparency = 1
		orbitPart.CanCollide = false
		orbitPart.Anchored = true
		orbitPart.Parent = workspace
		table.insert(orbitParts, orbitPart)

		local orbitAttach = Instance.new("Attachment") orbitAttach.Parent = orbitPart
		local fragEmitter = Instance.new("ParticleEmitter")
		fragEmitter.Texture = "rbxassetid://6333823"
		fragEmitter.Lifetime = NumberRange.new(0.3, 0.6)
		fragEmitter.Rate = 15
		fragEmitter.Speed = NumberRange.new(0.5, 1)
		fragEmitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0.1)})
		fragEmitter.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1)})
		fragEmitter.Color = ColorSequence.new(Color3.fromRGB(200, 150, 255))
		fragEmitter.LightEmission = 0.8
		fragEmitter.Parent = orbitAttach
		table.insert(effects, fragEmitter)

		local trail = Instance.new("Trail")
		trail.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(180, 120, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 100, 255))})
		trail.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1)})
		trail.Lifetime = 0.3
		trail.MinLength = 0.02
		trail.MaxLength = 0.1
		trail.FaceCamera = true
		local t1, t2 = Instance.new("Attachment"), Instance.new("Attachment")
		t1.Position, t2.Position = Vector3.new(-0.1,0,0), Vector3.new(0.1,0,0)
		t1.Parent, t2.Parent = orbitPart, orbitPart
		trail.Attachment0, trail.Attachment1 = t1, t2
		trail.Parent = orbitPart
	end

	-- Central light
	local pointLight = Instance.new("PointLight")
	pointLight.Color, pointLight.Range, pointLight.Brightness = Color3.fromRGB(160,120,255), 8, 1.5
	pointLight.Parent = torso
	table.insert(effects, pointLight)

	-- Ambient sound
	local soundEffect = Instance.new("Sound")
	soundEffect.SoundId, soundEffect.Volume, soundEffect.Looped = "rbxassetid://169445602", 0.7, true
	soundEffect.Parent = torso
	soundEffect:Play()
	table.insert(effects, soundEffect)

	-- Orbit animation
	coroutine.wrap(function()
		local angle = 0
		while centralAttach and centralAttach.Parent do
			local dt = wait()
			angle = angle + dt * 2
			for i, part in ipairs(orbitParts) do
				local a = angle + (i * 2 * math.pi / #orbitParts)
				local r = 3 + 0.5 * math.sin(angle * 0.5 + i)
				local h = math.sin(angle + i * 0.7)

				-- compute world-space position (Vector3)
				local worldPos = torso.CFrame:PointToWorldSpace(
					Vector3.new(math.cos(a) * r, h, math.sin(a) * r)
				)

				-- set the part's CFrame to that position
				part.CFrame = CFrame.new(worldPos)
				-- if you want them oriented toward the torso, use:
				-- part.CFrame = CFrame.new(worldPos, torso.Position)
			end
		end
	end)()

	-- Pulse effect
	spawn(function()
		while centralAttach and centralAttach.Parent do
			local pe = Instance.new("ParticleEmitter")
			pe.Texture, pe.Lifetime, pe.Speed = "rbxassetid://241555574", NumberRange.new(0.8,1), NumberRange.new(4,6)
			pe.Size = NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,8)})
			pe.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,0.2),NumberSequenceKeypoint.new(0.8,0.6),NumberSequenceKeypoint.new(1,1)})
			pe.LightEmission = 0.8
			pe.Parent = centralAttach; pe:Emit(1)
			local fe = Instance.new("ParticleEmitter") fe.Texture,fe.Lifetime,fe.Speed = "rbxassetid://1536547385", NumberRange.new(0.3,0.5), NumberRange.new(0.5,1)
			fe.Size = NumberSequence.new({NumberSequenceKeypoint.new(0,3),NumberSequenceKeypoint.new(1,1)})
			fe.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,0.2),NumberSequenceKeypoint.new(1,1)})
			fe.LightEmission = 0.9 fe.Parent=centralAttach fe:Emit(5)
			wait(0.2); if pe and pe.Parent then pe:Destroy() end; if fe and fe.Parent then fe:Destroy() end; wait(1.8)
		end
	end)

	local dist = Instance.new("Part")
	dist.Size = Vector3.new(8,8,8)
	dist.Transparency = 0.7
	dist.Material = Enum.Material.ForceField
	dist.Color = Color3.fromRGB(200,150,255)
	dist.Anchored = true
	dist.CanCollide = false   -- <<< prevent it from pushing players
	dist.CFrame = torso.CFrame
	dist.Parent = workspace
	coroutine.wrap(function() while dist and dist.Parent and torso.Parent do dist.CFrame=torso.CFrame wait(0.05) end end)()

	-- Cleanup function
	delay(6, function()
		-- destroy the central attachment & its emitters
		if centralAttach and centralAttach.Parent then centralAttach:Destroy() end

		-- destroy all the particle/sound effects
		for _, e in ipairs(effects) do
			if e and e.Parent then
				if e:IsA("Sound") then e:Stop() end
				e:Destroy()
			end
		end

		-- destroy your orbiting parts
		for _, p in ipairs(orbitParts) do
			if p and p.Parent then
				p:Destroy()
			end
		end

		-- *** NEW: destroy the dist part ***
		if dist and dist.Parent then
			dist:Destroy()
		end
	end)

	return centralAttach
end

