-- Main Event Handler
castSpellEvent.OnServerEvent:Connect(function(player, spellName, payload)
	local char     = player.Character
	if not char then return end
	local humanoid = char:FindFirstChild("Humanoid")
	if not humanoid then return end

	if spellName == "IceBarrier" then
		-- calculate shield amount & bind effect
		local pct    = tonumber(payload) or 25
		local amount = humanoid.MaxHealth * (pct/100)
		bindIceBarrier(player, humanoid, amount)

		-- show buff UI on client
		buffUIEvent:FireClient(
			player,
			"IceBarrier",
			"Start",
			60,
			"Ice Barrier",
			"Surrounds you with crystals that absorb damage for 60s."
		)

	elseif spellName == "IceBarrierExpired" then
		-- cleanup server-side
		cleanupBarrier(player)
		-- hide buff UI
		buffUIEvent:FireClient(player, "IceBarrier", "End")

	elseif spellName == "BlazingSpeed" then
		-- parse payload, apply speed buff & effects
		local multiplier = tonumber(payload) or 1.5
		local duration   = 6
		OriginalWalkSpeeds[player] = humanoid.WalkSpeed
		humanoid.WalkSpeed         = humanoid.WalkSpeed * multiplier

		-- VFX + trail
		attachParticleVFX(char, {
			Texture      = "rbxassetid://6686254194",
			Rate         = 100,
			Lifetime     = NumberRange.new(0.2, 0.5),
			Speed        = NumberRange.new(2, 3),
			Size         = NumberSequence.new(1),
			Color        = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255,   0)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 100,   0)),
			}),
			LightEmission = 0.8,
		}, duration)
		createBlazingTrail(char)
		bindBlazingSpeed(player, duration)

		-- show buff UI on client
		buffUIEvent:FireClient(
			player,
			"BlazingSpeed",
			"Start",
			duration,
			"Blazing Speed",
			"Increases your speed by " .. math.floor((multiplier - 1) * 100) .. "% for " .. duration .. "s."
		)

	elseif spellName == "BlazingSpeedExpired" then
		-- restore speed server-side
		if OriginalWalkSpeeds[player] then
			humanoid.WalkSpeed = OriginalWalkSpeeds[player]
			OriginalWalkSpeeds[player] = nil
		end
		hideBuffFrame(player, "BlazingSpeed")
		-- hide buff UI
		buffUIEvent:FireClient(player, "BlazingSpeed", "End")

	elseif spellName == "AlterTimeStart" then
		-- save state, play VFX, bind buff
		if char.PrimaryPart then
			AlterTimePositions[player] = char.PrimaryPart.Position
			AlterTimeHealths[player]   = humanoid.Health
		end
		attachParticleVFX(char, {
			Texture      = "rbxassetid://6761866149",
			Rate         = 60,
			Lifetime     = NumberRange.new(0.8, 1.2),
			Speed        = NumberRange.new(0.5, 1),
			Size         = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 2),
				NumberSequenceKeypoint.new(1, 0),
			}),
			Color        = ColorSequence.new(Color3.fromRGB(200,150,255)),
			RotSpeed     = NumberRange.new(-180, 180),
		}, 6)
		createTimeVortex(char)
		bindAlterTime(player, 6)

		-- show buff UI on client
		buffUIEvent:FireClient(
			player,
			"AlterTime",
			"Start",
			6,
			"Alter Time",
			"Rewind you back to your position and health when cast ends."
		)

	elseif spellName == "AlterTimeComplete" then
		-- server-side restore
		hideBuffFrame(player, "AlterTime")
		local origPos    = AlterTimePositions[player]
		local origHealth = AlterTimeHealths[player]
		if origPos then
			createAlterTimeCompleteEffect(char, origPos)
			char:SetPrimaryPartCFrame(CFrame.new(origPos))
		end
		if origHealth then humanoid.Health = origHealth end
		AlterTimePositions[player] = nil
		AlterTimeHealths[player]   = nil

		-- hide buff UI
		buffUIEvent:FireClient(player, "AlterTime", "End")

	elseif spellName == "AlterTimeFailed" then
		-- just clear without applying
		hideBuffFrame(player, "AlterTime")
		AlterTimePositions[player] = nil
		AlterTimeHealths[player]   = nil

		-- hide buff UI
		buffUIEvent:FireClient(player, "AlterTime", "End")
	end
end)
