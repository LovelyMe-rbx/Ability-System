-- SpellEffectHandler (ServerScriptService)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local BuffUiTemplate    = ReplicatedStorage:WaitForChild("BuffUi")
local buffUIEvent      = ReplicatedStorage:WaitForChild("BuffUIEvent")
local Players           = game:GetService("Players")
local castSpellEvent    = ReplicatedStorage:WaitForChild("CastSpellEvent")

-- UI helper: manage per-player BillboardGui
local BuffUis = {}  -- [player] = cloned BuffUi
local function getBuffGui(player)
	if BuffUis[player] and BuffUis[player].Parent then
		return BuffUis[player]
	end
	local char = player.Character or player.CharacterAdded:Wait()
	local head = char:WaitForChild("Head")
	local gui = BuffUiTemplate:Clone()
	gui.Parent = head
	gui.Enabled = true
	-- hide all buff frames by default
	for _, f in ipairs(gui:GetChildren()) do
		if f:IsA("Frame") then f.Visible = false end
	end
	BuffUis[player] = gui
	return gui
end

local function hideBuffFrame(player, abilityName)
	local gui = BuffUis[player]
	if not gui then return end
	local f = gui:FindFirstChild(abilityName)
	if f then f.Visible = false end
end

-- State tables
local IceBarrierBuffUis   = {}    -- [player] = cloned BillboardGui
local IceBarrierShields   = {}    -- [player] = remaining absorb
local IceBarrierConns     = {}    -- [player] = HealthChanged conn
local IceBarrierEffects   = {}    -- [player] = {centralAttachment, cleanup, createDamageFeedback}
local IceBarrierTimers = {}   -- [player] = thread
local OriginalWalkSpeeds  = {}    -- [player] = number
local AlterTimePositions  = {}    -- [player] = Vector3
local AlterTimeHealths = {}  -- [player] = health at cast time
local IceBarrierCountdowns = {}  -- [player] = thread de cuenta atrás
local IceBarrierCleanups = {}    -- [player] = thread de limpieza


-- Cleanup helper for Ice Barrier

local function cleanupBarrier(player)
	-- disconnect the health listener
	if IceBarrierConns[player] then
		IceBarrierConns[player]:Disconnect()
		IceBarrierConns[player] = nil
	end

	-- clear the absorb value
	IceBarrierShields[player] = nil

	-- hide the buff icon
	hideBuffFrame(player, "IceBarrier")

	-- destroy any dedicated VFX/UI you stored (if you’re using IceBarrierBuffUis, etc.)
	if IceBarrierBuffUis[player] then
		IceBarrierBuffUis[player]:Destroy()
		IceBarrierBuffUis[player] = nil
	end

	if IceBarrierEffects[player] then
		IceBarrierEffects[player].cleanup()
		IceBarrierEffects[player] = nil
	end
end

-- Cleanup on respawn/removal
local function cleanupPlayer(player)
	-- Destroy any existing BuffUi so we’ll re-clone it next time
	if BuffUis[player] then
		BuffUis[player]:Destroy()
		BuffUis[player] = nil
	end

	cleanupBarrier(player)
	OriginalWalkSpeeds[player]   = nil
	AlterTimePositions[player]   = nil
	AlterTimeHealths[player]     = nil
end

Players.PlayerRemoving:Connect(cleanupPlayer)
Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		cleanupPlayer(player)
	end)
end)

Players.PlayerRemoving:Connect(cleanupPlayer)
Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		cleanupPlayer(player)
	end)
end)

-- Helper: attach basic particle effect and return the Attachment
local function attachParticleVFX(char, properties, duration, targetPart)
	local part = targetPart or char.PrimaryPart
	if not part then return nil end

	local attachment = Instance.new("Attachment")
	attachment.Parent = part
	local emitter = Instance.new("ParticleEmitter")
	for prop, val in pairs(properties) do
		emitter[prop] = val
	end
	emitter.Parent = attachment

	delay(duration, function()
		emitter.Enabled = false
		wait(1)
		if attachment and attachment.Parent then
			attachment:Destroy()
		end
	end)

	return attachment
end

