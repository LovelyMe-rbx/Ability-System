end

-- Bind Ice Barrier logic
local function bindIceBarrier(player, humanoid, amount)
	-- cleanup any existing barrier first
	cleanupBarrier(player)
	-- store new shield amount
	IceBarrierShields[player] = amount

	-- show buff icon
	local char   = player.Character or player.CharacterAdded:Wait()
	local gui    = getBuffGui(player)
	local frame  = gui:FindFirstChild("IceBarrier")
	frame.Visible = true

	-- countdown setup
	local duration  = 60
	local imageLabel = frame:FindFirstChildWhichIsA("ImageLabel")
	local countdownLbl = imageLabel and imageLabel:FindFirstChild("Countdown")
	local overlay      = imageLabel and imageLabel:FindFirstChild("CooldownOverlay")

	if countdownLbl then
		-- Cancela sólo el contador anterior
		if IceBarrierCountdowns[player] then
			task.cancel(IceBarrierCountdowns[player])
		end

		IceBarrierCountdowns[player] = task.spawn(function()
			for rem = duration, 1, -1 do
				if not countdownLbl.Parent then break end
				countdownLbl.Text = tostring(rem)
				if overlay then
					overlay.Size = UDim2.new(1, 0, rem / duration, 0)
				end
				task.wait(1)
			end
			-- Al acabar la cuenta atrás, oculta y limpia todo
			frame.Visible = false
			cleanupBarrier(player)
			IceBarrierCountdowns[player] = nil
		end)
	end

	-- original VFX + health hook
	local prevHealth = humanoid.Health
	local effectData = createDampenHarmAura(char)
	IceBarrierEffects[player] = effectData

	local conn = humanoid.HealthChanged:Connect(function(newHealth)
		local shield = IceBarrierShields[player]
		if shield and newHealth < prevHealth then
			local dmg = prevHealth - newHealth
			if shield > dmg then
				IceBarrierShields[player] = shield - dmg
				humanoid.Health = newHealth + dmg
			else
				humanoid.Health = newHealth + shield
				cleanupBarrier(player)
			end
			effectData.createDamageFeedback()
		end
		prevHealth = humanoid.Health
	end)
	IceBarrierConns[player] = conn

	-- schedule cleanup after duration
	IceBarrierTimers[player] = task.delay(duration, function()
		cleanupBarrier(player)
	end)
end

