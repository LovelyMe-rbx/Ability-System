local multiActionSlot5       = leftMultiActionBarFrame:WaitForChild("MultiActionSlot5")
local multiActionSlot6       = leftMultiActionBarFrame:WaitForChild("MultiActionSlot6")

local cooldownOverlay1 = multiActionSlot4:FindFirstChild("CooldownOverlay")
local cooldownOverlay2 = multiActionSlot5:FindFirstChild("CooldownOverlay")
local cooldownOverlay3 = multiActionSlot6:FindFirstChild("CooldownOverlay")

-- Casting Bar
local abilityBars = playerGui:WaitForChild("AbilityBars")
